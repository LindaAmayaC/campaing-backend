# Token permanente / temporal de la app de Meta (WhatsApp Cloud API)
WHATSAPP_TOKEN="EAAYBGYNIO8kBRNafx5ZBW1oPlwa6sZBfYoRsTVClIcmG4IdvGtjaLdvGeL8dvDlYYkcBF2CP3CP65KWC7I9VXZCut6WLa6OkPiZAifTaW1ZAOn1S9FvqjvYgQQZAwsTX70xSD9qjXQe2CVMZBIoFojsNBMPfZA8NTm1QoHiNdOggXDmBvwJbTZAI7wFw4nqySOgZDZD";

# WABA ID (WhatsApp Business Account). Usado por GET /whatsapp/templates.
# Si lo defines aquí, el frontend no necesita mandarlo en la query.
WHATSAPP_WABA_ID=884624741237033

# Credenciales Onmall / messaging-service para SMS.
# Formato: "Basic <base64>" o solo el base64 (se prefija automáticamente).
ONMALL_AUTH=Vnl2dHVyaXNtbzpWaWFqZXN5dmlhamVzdHVyaXNtbzIwMjYu
# Remitente del SMS (visible al destinatario)
ONMALL_FROM=CompanyName

# Secret para autenticar requests al backend.
# Genera uno con: openssl rand -hex 32
# Si está vacío, los endpoints quedan abiertos (modo dev).
# Frontend debe enviarlo en header X-Api-Key o Authorization: Bearer.
API_SECRET=

# =====================
# Amazon SES (envío de correos vía /apply-campaign/email)
# =====================
# Región de SES — la misma donde se verificó el dominio (ej: us-east-1).
AWS_REGION=us-east-1
# Credenciales del IAM user con permiso ses:SendEmail (o AmazonSESFullAccess).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Remitente por defecto (debe estar verificado en SES; mismo dominio del DKIM).
SES_DEFAULT_FROM=no-reply@viajesyviajes.com

# Puerto local (Railway inyecta su propio PORT)
PORT=3000

# =====================
# Base de datos (tracking de entregas — Fase 2)
# =====================
# Postgres para persistir cada mensaje enviado con su provider_message_id y
# poder cruzar las respuestas de entrega de SES / Meta / Onmall.
# En Railway: agregar el plugin "Postgres" y referenciar su variable, ej:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Si se deja VACÍA, el tracking queda desactivado y el backend sigue enviando
# con normalidad (la persistencia es opcional).
DATABASE_URL=
